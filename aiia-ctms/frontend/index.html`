<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AIIA Clinical Intelligence Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-slate-50 font-sans text-slate-900">

    <div class="fixed left-0 top-0 h-full w-64 bg-emerald-900 text-white p-5 space-y-8">
        <div class="text-2xl font-bold flex items-center gap-2">
            <i class="fas fa-leaf text-emerald-400"></i> AIIA CTMS
        </div>
        <nav class="space-y-4">
            <a href="#" onclick="showPage('overview')" class="flex items-center gap-3 p-3 rounded-lg bg-emerald-700 hover:bg-emerald-600 transition"><i class="fas fa-home"></i> Overview</a>
            <a href="#" onclick="showPage('trials')" class="flex items-center gap-3 p-3 rounded-lg hover:bg-emerald-800 transition"><i class="fas fa-list"></i> Trial Management</a>
            <a href="#" onclick="showPage('safety')" class="flex items-center gap-3 p-3 rounded-lg hover:bg-emerald-800 transition"><i class="fas fa-biohazard text-red-400"></i> Pharmacovigilance</a>
            <a href="#" onclick="showPage('ai')" class="flex items-center gap-3 p-3 rounded-lg hover:bg-emerald-800 transition"><i class="fas fa-robot text-purple-400"></i> AI Analyzer</a>
            <a href="#" onclick="showPage('matching')" class="flex items-center gap-3 p-3 rounded-lg hover:bg-emerald-800 transition"><i class="fas fa-user-check text-blue-400"></i> Patient Matcher</a>
            <a href="#" onclick="exportFHIR()" class="flex items-center gap-3 p-3 rounded-lg hover:bg-emerald-800 transition"><i class="fas fa-file-export text-green-400"></i> CDISC/FHIR Export</a>
        </nav>
    </div>

    <div class="ml-64 p-10">
        <!-- OVERVIEW -->
        <div id="page-overview" class="page space-y-8">
            <h1 class="text-3xl font-bold">Ayurveda Research Overview</h1>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="p-6 bg-white shadow rounded-2xl border-b-4 border-emerald-500">
                    <p class="text-slate-500 text-sm uppercase font-semibold">Active Trials</p>
                    <p id="stat-trials" class="text-4xl font-bold">...</p>
                </div>
                <div class="p-6 bg-white shadow rounded-2xl border-b-4 border-blue-500">
                    <p class="text-slate-500 text-sm uppercase font-semibold">Enrollment Rate</p>
                    <p id="stat-enrollment" class="text-4xl font-bold">...%</p>
                </div>
                <div class="p-6 bg-white shadow rounded-2xl border-b-4 border-red-500">
                    <p class="text-slate-500 text-sm uppercase font-semibold">Adverse Events</p>
                    <p id="stat-safety" class="text-4xl font-bold">...</p>
                </div>
                <div class="p-6 bg-white shadow rounded-2xl border-b-4 border-purple-500">
                    <p class="text-slate-500 text-sm uppercase font-semibold">AI Risk Score</p>
                    <p id="stat-risk" class="text-4xl font-bold text-orange-600">...</p>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="bg-white p-6 shadow rounded-2xl">
                    <h3 class="text-lg font-bold mb-4">Enrollment Progress</h3>
                    <div class="h-64"><canvas id="trialChart"></canvas></div>
                </div>
                <div class="bg-white p-6 shadow rounded-2xl border border-orange-100 bg-orange-50">
                    <h3 class="text-lg font-bold text-orange-800 mb-2"><i class="fas fa-robot"></i> AI Intelligence Insight</h3>
                    <div id="ai-insight-container" class="space-y-4">
                        <p id="ai-insight" class="text-slate-700 italic">Connecting to Gemma 4...</p>
                        <div id="ai-summary-box" class="hidden p-3 bg-white border border-orange-200 rounded-lg text-sm text-slate-600 shadow-sm">
                            <strong class="block mb-1">Clinical Summary:</strong> <span id="ai-summary-text"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- AI ANALYZER -->
        <div id="page-ai" class="page hidden space-y-6">
            <h1 class="text-3xl font-bold">AI Multimodal Protocol Analyzer</h1>
            <div class="bg-white p-8 shadow rounded-2xl max-w-5xl">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div>
                        <label class="block text-sm font-semibold mb-2">Upload Document</label>
                        <input type="file" id="file-upload" class="w-full p-2 border rounded-lg bg-slate-50">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Or Paste Text</label>
                        <textarea id="ai-input" rows="3" class="w-full p-2 border rounded-lg outline-none" placeholder="Paste protocol..."></textarea>
                    </div>
                </div>
                <button onclick="analyzeDocument()" class="w-full bg-emerald-600 text-white py-3 rounded-xl font-bold hover:bg-emerald-700 transition">Analyze with Gemma 4</button>
                <div id="ai-result-container" class="mt-8 hidden space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="bg-white p-4 shadow rounded-xl border-t-4 border-blue-500"><h4 class="text-xs uppercase font-bold text-slate-500">Summary</h4><p id="res-summary" class="text-sm"></p></div>
                        <div class="bg-white p-4 shadow rounded-xl border-t-4 border-orange-500"><h4 class="text-xs uppercase font-bold text-slate-500">Risk</h4><p id="res-risk" class="text-lg font-bold"></p></div>
                        <div class="bg-white p-4 shadow rounded-xl border-t-4 border-emerald-500"><h4 class="text-xs uppercase font-bold text-slate-500">Sample Size</h4><p id="res-sample" class="text-lg font-bold"></p></div>
                    </div>
                    <div class="bg-white shadow rounded-xl overflow-hidden">
                        <table class="w-full text-left">
                            <thead class="bg-slate-100 border-b"><tr><th class="p-4">Parameter</th><th class="p-4">Value</th></tr></thead>
                            <tbody id="res-table-body"></tbody>
                        </table>
                    </div>
                    <div class="bg-slate-900 p-4 rounded-xl text-green-400 font-mono text-xs overflow-auto" id="raw-json"></div>
                </div>
            </div>
        </div>

        <!-- MATCHING -->
        <div id="page-matching" class="page hidden space-y-6">
            <h1 class="text-3xl font-bold">Precision Patient Matching</h1>
            <div class="bg-white p-8 shadow rounded-2xl max-w-4xl">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div><label class="block text-sm font-semibold mb-2">Patient Record</label><textarea id="patient-data" rows="5" class="w-full p-3 border rounded-lg"></textarea></div>
                    <div><label class="block text-sm font-semibold mb-2">Trial Criteria</label><textarea id="trial-criteria" rows="5" class="w-full p-3 border rounded-lg"></textarea></div>
                </div>
                <button onclick="matchPatient()" class="w-full bg-blue-600 text-white py-3 rounded-xl font-bold hover:bg-blue-700">Calculate Match Percentage</button>
                <div id="match-result" class="mt-8 hidden p-6 bg-white border-2 border-blue-100 rounded-2xl text-center">
                    <div id="match-pct" class="text-6xl font-black text-blue-600 mb-2">0%</div>
                    <div id="match-verdict" class="text-xl font-bold mb-4">Verdict</div>
                    <div id="match-reasons" class="text-left text-slate-600 bg-slate-50 p-4 rounded-lg"></div>
                </div>
            </div>
        </div>
        
        <!-- Placeholder pages for others -->
        <div id="page-trials" class="page hidden"><h1 class="text-3xl font-bold">Trial Management</h1><div id="trial-table-container" class="mt-6"></div></div>
        <div id="page-safety" class="page hidden"><h1 class="text-3xl font-bold">Pharmacovigilance</h1><div id="safety-container" class="mt-6"></div></div>

    </div>

    <script>
        const API = 'http://localhost:8000';
        let myChart = null;

        function showPage(pageId) {
            document.querySelectorAll('.page').forEach(p => p.classList.add('hidden'));
            document.getElementById('page-' + pageId).classList.remove('hidden');
            if(pageId === 'overview') initDashboard();
        }

        async function initDashboard() {
            try {
                const res = await fetch(`${API}/api/trials`);
                const trials = await res.json();
                document.getElementById('stat-trials').innerText = trials.length;
                const totalEnroll = trials.reduce((acc, t) => acc + t.enrollment, 0);
                const totalTarget = trials.reduce((acc, t) => acc + (t.target_sample_size || 100), 0);
                document.getElementById('stat-enrollment').innerText = Math.round((totalEnroll / totalTarget) * 100) + '%';
                
                const sRes = await fetch(`${API}/api/safety/`);
                const safety = await sRes.json();
                document.getElementById('stat-safety').innerText = safety.length;

                const ctx = document.getElementById('trialChart').getContext('2d');
                if(myChart) myChart.destroy();
                myChart = new Chart(ctx, {
                    type: 'bar',
                    data: { labels: trials.map(t => t.title), datasets: [{ label: 'Enrollment', data: trials.map(t => t.enrollment), backgroundColor: '#10b981', borderRadius: 8 }] },
                    options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true } } }
                });

                fetchAIInsight(trials);
            } catch(e) {
                document.getElementById('ai-insight').innerText = "⚠️ Backend offline.";
            }
        }

        async function fetchAIInsight(trials) {
            try {
                const res = await fetch(`${API}/api/ai/analyze-document`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ text: `Summary of trials: ${JSON.stringify(trials)}. Provide a risk summary.` })
                });
                if(!res.ok) throw new Error("Server Error");
                const data = await res.json();
                const analysis = JSON.parse(data.analysis);
                document.getElementById('ai-insight').innerText = analysis.summary || "No insight available.";
                document.getElementById('ai-summary-box').classList.remove('hidden');
                document.getElementById('ai-summary-text').innerText = analysis.structured_data?.risk_analysis || "No risks detected.";
            } catch(e) {
                document.getElementById('ai-insight').innerText = "AI Offline - Check Ollama";
            }
        }

        async function analyzeDocument() {
            const fileInput = document.getElementById('file-upload');
            const textInput = document.getElementById('ai-input');
            const resDiv = document.getElementById('raw-json');
            const container = document.getElementById('ai-result-container');
            
            resDiv.classList.remove('hidden');
            resDiv.innerText = "Analyzing...";
            container.classList.remove('hidden');

            const formData = new FormData();
            if (fileInput.files[0]) formData.append('file', fileInput.files[0]);
            else if (textInput.value) formData.append('file', new Blob([textInput.value]), 'text.txt');
            else return alert("Provide input!");

            try {
                const res = await fetch(`${API}/api/ai/analyze-document`, { method: 'POST', body: formData });
                if(!res.ok) throw new Error(await res.text());
                const data = await res.json();
                const analysis = JSON.parse(data.analysis);
                
                document.getElementById('res-summary').innerText = analysis.summary;
                document.getElementById('res-risk').innerText = analysis.risk_score;
                document.getElementById('res-sample').innerText = analysis.structured_data?.sample_size || "N/A";

                const tableBody = document.getElementById('res-table-body');
                tableBody.innerHTML = '';
                Object.entries(analysis.structured_data || {}).forEach(([k, v]) => {
                    tableBody.innerHTML += `<tr class="border-b"><td class="p-4 font-bold">${k}</td><td class="p-4">${v}</td></tr>`;
                });

                resDiv.innerText = JSON.stringify(analysis, null, 2);
            } catch(e) {
                resDiv.innerText = "AI Error: " + e.message;
            }
        }

        async function matchPatient() {
            const pData = document.getElementById('patient-data').value;
            const tCrit = document.getElementById('trial-criteria').value;
            const resDiv = document.getElementById('match-result');
            resDiv.classList.remove('hidden');
            resDiv.innerHTML = "Calculating...";

            try {
                const res = await fetch(`${API}/api/ai/patient-match`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ patient_data: pData, trial_criteria: tCrit })
                });
                const data = await res.json();
                const match = JSON.parse(data.match);
                document.getElementById('match-pct').innerText = match.match_percentage + '%';
                document.getElementById('match-verdict').innerText = match.verdict;
                document.getElementById('match-reasons').innerText = match.reasons.join('\n');
            } catch(e) {
                resDiv.innerText = "Match failed.";
            }
        }

        async function exportFHIR() {
            const res = await fetch(`${API}/api/fhir/export`);
            const data = await res.json();
            const blob = new Blob([JSON.stringify(data, null, 2)], {type: 'application/json'});
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = 'aiia_fhir_export.json'; a.click();
        }

        window.onload = initDashboard;
    </script>
</body>
</html>
